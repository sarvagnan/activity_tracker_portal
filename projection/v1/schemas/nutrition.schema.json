 "$defs": {
  "DataOrigin": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "package_name"
   ],
   "properties": {
    "package_name": {
     "type": "string"
    }
   }
  },
  "Device": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "type": "integer",
     "enum": [
      0,
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8
     ]
    },
    "manufacturer": {
     "type": "string"
    },
    "model": {
     "type": "string"
    }
   }
  },
  "Metadata": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "client_record_version",
    "data_origin",
    "id",
    "last_modified_time",
    "recording_method"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "data_origin": {
     "$ref": "#/$defs/DataOrigin"
    },
    "last_modified_time": {
     "type": "string",
     "pattern": "^([0-9]{4}-((0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-8])|(0[13-9]|1[0-2])-(29|30)|(0[13578]|1[02])-31)|([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.([0-9]{3}|[0-9]{6}|[0-9]{9}))?Z$"
    },
    "client_record_id": {
     "type": "string"
    },
    "client_record_version": {
     "type": "string",
     "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "recording_method": {
     "type": "integer",
     "enum": [
      0,
      1,
      2,
      3
     ]
    },
    "device": {
